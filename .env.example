# URL of the deployed parse-receipt function, e.g. https://<project>.supabase.co/functions/v1/parse-receipt
EXPO_PUBLIC_RECEIPT_API_URL=
# Supabase anon (public) key, sent as the bearer token to the function. Never put the Anthropic key here.
EXPO_PUBLIC_RECEIPT_API_KEY=

# Household sharing. With these two set, the receipt URL and key above can stay empty.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Domain your inbound-email provider receives mail for, e.g. receipts.example.com
EXPO_PUBLIC_RECEIPT_EMAIL_DOMAIN=
